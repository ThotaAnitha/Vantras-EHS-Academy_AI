VANTRAS_HOST=127.0.0.1
VANTRAS_PORT=8173
VANTRAS_NO_BROWSER=0
# Production examples:
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...
# RAZORPAY_KEY_ID=...
# RAZORPAY_KEY_SECRET=...

# Genius AI cloud provider
# Put the real key only in your local .env file. Do not commit/share it.
ZAI_API_KEY=1ad1a7f1149c47a98f85763df525fba1.5YjCcZWSRPa6yy5b
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_MODEL=glm-4.5-flash
ZAI_FREE_FALLBACK_MODEL=glm-4.7-flash
ZAI_TIMEOUT_SECONDS=25
ZAI_MAX_OUTPUT_TOKENS=4096
ZAI_THINKING=disabled
AGENTIC_TOOL_CALLING=true
AI_CONTEXT_MAX_CHARS=7000

# Local provider / immediate fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_NUM_PREDICT=1400
OLLAMA_KEEP_ALIVE=30m
OLLAMA_AUTO_START=true
OLLAMA_AUTO_PULL=true

# Start Z.AI and Ollama together; first successful complete answer is shown.
AI_PROVIDER_RACE=true
